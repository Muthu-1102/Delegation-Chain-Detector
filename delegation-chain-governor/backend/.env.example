# Application
APP_NAME=Delegation Chain Governor
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://dcg_user:dcg_password@postgres:5432/dcg_db

# JWT / Delegation
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_DELEGATION_TOKEN_TTL_SECONDS=120

# Groq API (LLM provider for LangGraph agents)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# CORS
FRONTEND_ORIGIN=http://localhost:5173
